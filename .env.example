# IKPS v1.0.0 Environment Variables
# Internal Knowledge Production System

# ============= Layer Configuration =============
IKPS_LAYER_1_ENABLED=true
IKPS_LAYER_2_ENABLED=true
IKPS_LAYER_3_ENABLED=true

# ============= Layer 1: Entity Layer =============
IKPS_ENTITY_EXTRACTION_METHOD=rule_based
IKPS_ENTITY_MAX_PER_INPUT=50
IKPS_ENTITY_MIN_CONFIDENCE=0.6

# ============= Layer 2: Interaction Layer =============
IKPS_INTERACTION_METRICS=entropy,drift,assumption,affective
IKPS_INTERACTION_WINDOW_SIZE=10
IKPS_INTERACTION_NORMALIZATION=l2

# ============= Layer 3: Documentation Layer =============
IKPS_DOCUMENTATION_FORMAT=json
IKPS_DOCUMENTATION_TIMESTAMP=true
IKPS_DOCUMENTATION_SNAPSHOT_MODE=independent

# ============= Core Rules =============
IKPS_NO_ARCHIVAL=true
IKPS_NO_CANONICAL_REFERENCE=true
IKPS_STRICT_LAYER_SEPARATION=true

# ============= Output Configuration =============
IKPS_OUTPUT_DIR=./reports
IKPS_OUTPUT_PREFIX=ikps_snapshot

# ============= Logging =============
IKPS_LOG_LEVEL=INFO
IKPS_LOG_LAYER_TRACE=false

# ============= API Keys (Optional) =============
# GITHUB_TOKEN=your_token_here
